# Base URL of the MAP backend API
VITE_API_BASE_URL=http://localhost:8001/api

# The MAP API key, sent as the x-api-key header on every Shopify-related request.
# It is compiled into the browser bundle - anyone who can open the site can read it.
# Must equal MAP_API_KEY in the backend .env. Restart `npm run dev` after changing it.
VITE_MAP_API_KEY=YOUR_MAP_API_KEY
